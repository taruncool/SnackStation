# Android project: generated by `npx cap add android` — ignored, except the
# few files with our own changes (Bluetooth printer plugin, permissions, and
# the Gradle/SDK versions this machine builds with).
/android/**
!/android/**/
!/android/app/src/main/java/com/snackstation/app/MainActivity.java
!/android/app/src/main/java/com/snackstation/app/ThermalPrinterPlugin.java
!/android/app/src/main/AndroidManifest.xml
!/android/build.gradle
!/android/variables.gradle
!/android/gradle/wrapper/gradle-wrapper.properties
